{
  "name": "@api-marketplace/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Marketplace backend service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --require ts-node/register/transpile-only --test src/__tests__/otp.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "seed:billing": "node -r dotenv/config -r ts-node/register/transpile-only scripts/seed-billing.ts dotenv_config_path=../.env.development"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@prisma/client": "^5.0.0",
    "@types/pg": "^8.21.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.0",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.0"
  }
}