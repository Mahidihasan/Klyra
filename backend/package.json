{
  "name": "@api-marketplace/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Marketplace backend service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --require ts-node/register/transpile-only --test src/__tests__/otp.test.ts src/__tests__/operations.test.ts src/__tests__/login-totp.test.ts src/__tests__/account-deactivation.test.ts src/__tests__/docker.deploy.test.ts src/__tests__/upload.security.test.ts src/__tests__/gateway.docker.test.ts src/__tests__/github.source.test.ts src/__tests__/deployment.source.test.ts src/__tests__/projectbuild.build.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:audit": "node scripts/audit-db.mjs",
    "db:migrate:payouts": "node -r dotenv/config -r ts-node/register/transpile-only scripts/migrate_payouts.ts dotenv_config_path=../.env.development",
    "db:migrate:audit": "node -r dotenv/config -r ts-node/register/transpile-only scripts/migrate_audit.ts dotenv_config_path=../.env.development",
    "seed:rbac": "node -r dotenv/config -r ts-node/register/transpile-only scripts/seed-rbac.ts dotenv_config_path=../.env.development",
    "seed:billing": "node -r dotenv/config -r ts-node/register/transpile-only scripts/seed-billing.ts dotenv_config_path=../.env.development",
    "seed:marketplace": "node -r dotenv/config -r ts-node/register/transpile-only scripts/seed-marketplace.ts dotenv_config_path=../.env.development",
    "seed:api-build": "node -r dotenv/config -r ts-node/register/transpile-only scripts/seed-api-build-project.ts dotenv_config_path=../.env.development",
    "seed:usage": "node -r dotenv/config -r ts-node/register/transpile-only scripts/seed-usage.ts dotenv_config_path=../.env.development",
    "clean:usage": "node -r dotenv/config -r ts-node/register/transpile-only scripts/clean-usage.ts dotenv_config_path=../.env.development"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@prisma/client": "^5.0.0",
    "@types/pg": "^8.21.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "geoip-lite": "^2.0.3",
    "multer": "^1.4.5-lts.1",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.0"
  }
}
