generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String                    @unique(map: "users_email_unique") @db.Citext
  passwordHash             String                    @map("password_hash")
  name                     String                    @db.VarChar(100)
  role                     user_role                 @default(USER)
  avatar_url               String?                   @db.VarChar(500)
  avatar_public_id         String?                   @db.VarChar(200)
  avatar_metadata          Json?
  bio                      String?
  company                  String?                   @db.VarChar(255)
  website                  String?                   @db.VarChar(500)
  emailVerifiedAt          DateTime?                 @map("email_verified_at") @db.Timestamptz(6)
  status                   user_status               @default(ACTIVE)
  isActive                 Boolean                   @default(true) @map("is_active")
  two_factor_enabled       Boolean                   @default(false)
  two_factor_secret        String?
  last_login_at            DateTime?                 @db.Timestamptz(6)
  last_login_ip            String?                   @db.Inet
  metadata                 Json                      @default("{}")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at               DateTime                  @default(now()) @db.Timestamptz(6)
  deleted_at               DateTime?                 @db.Timestamptz(6)
  api_analytics            api_analytics[]
  api_keys                 api_keys[]
  api_reviews              api_reviews[]
  apis                     apis[]
  audit_logs               AuditLog[]
  collections              collections[]
  email_verifications      email_verifications[]
  environments             environments[]
  invoices                 invoices[]
  notification_preferences notification_preferences?
  notifications            notifications[]
  payments                 payments[]
  request_history          request_history[]
  saved_requests           saved_requests[]
  system_settings          system_settings[]
  user_sessions            user_sessions[]
  user_subscriptions       user_subscriptions[]

  @@index([email(ops: raw("gin_trgm_ops"))], map: "idx_users_email_trgm", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_users_name_trgm", type: Gin)
  @@map("users")
}

model klyra_migrations {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("_klyra_migrations")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model api_analytics {
  id             String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  api_id         String         @db.Uuid
  api_key_id     String?        @db.Uuid
  user_id        String?        @db.Uuid
  request_method request_method
  endpoint       String
  status_code    Int?
  latency_ms     Int?
  user_agent     String?
  ip_address     String?        @db.Inet
  country_code   String?        @db.Char(2)
  is_error       Boolean        @default(false)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  apis           apis           @relation(fields: [api_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  api_keys       api_keys?      @relation(fields: [api_key_id], references: [id], onUpdate: NoAction)
  users          User?          @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@id([id, created_at])
  @@index([api_id, created_at(sort: Desc)], map: "idx_api_analytics_api_id")
  @@index([api_key_id, created_at(sort: Desc)], map: "idx_api_analytics_api_key_id")
  @@index([created_at(sort: Desc)], map: "idx_api_analytics_created_at")
  @@index([api_id, endpoint, created_at(sort: Desc)], map: "idx_api_analytics_endpoint")
  @@index([api_id, status_code, created_at(sort: Desc)], map: "idx_api_analytics_status_code")
  @@index([user_id, created_at(sort: Desc)], map: "idx_api_analytics_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
