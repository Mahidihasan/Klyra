# Application
NODE_ENV=development
APP_NAME=API Marketplace Dev
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=secret
POSTGRES_DB=
DATABASE_URL=

# Redis
REDIS_PASSWORD=secret
REDIS_URL=redis://default:secret@localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Gemini (AI Copilot)
GEMINI_API_KEY=

# Gemini Automatic Request Inspector
GEMINI_INSPECTOR_MODEL=gemini-2.5-flash

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=dev@ethereal.email
SMTP_PASSWORD=dev-password
EMAIL_FROM=API Marketplace Dev <noreply@apimarketplace.com>

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true